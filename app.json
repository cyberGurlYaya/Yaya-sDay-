{
  "expo": {
    "name": "Yaya'sDay",
    "slug": "yaya-day",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "yaya-day",
    "plugins": ["expo-router", "expo-notifications", "expo-splash-screen"],
    "android": {
      "package": "com.yayasday.app",
      "permissions": ["SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS"]
    },
    "ios": {
      "bundleIdentifier": "com.yayasday.app"
    }
  }
}
